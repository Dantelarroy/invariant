{
  "name": "invariant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "prepare": "husky",
    "db:generate": "pnpm --filter @invariant/db generate",
    "db:migrate": "pnpm --filter @invariant/db migrate",
    "extract:text": "pnpm --filter @invariant/api extract:text",
    "review": "pnpm --filter @invariant/api review",
    "py:check": "cd python/data && uv run --frozen ruff check . && uv run --frozen ruff format --check . && uv run --frozen pytest -q",
    "synth": "pnpm --filter @invariant/synth generate"
  },
  "packageManager": "pnpm@10.29.2",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.13.6",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
