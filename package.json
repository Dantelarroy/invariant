{
  "name": "invariant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "prepare": "husky",
    "db:generate": "pnpm --filter @invariant/db generate",
    "db:migrate": "pnpm --filter @invariant/db migrate"
  },
  "packageManager": "pnpm@10.29.2",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.13.6",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
