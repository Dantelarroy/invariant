# Copy to .env (never commit .env). Local-only credentials for docker-compose.
DATABASE_URL=postgres://invariant:invariant_local_only@localhost:5433/invariant

# Language model for extraction (OpenAI via AI SDK). Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-5-mini

# DocILE dataset access token, from https://docile.rossum.ai (never commit it)
DOCILE_TOKEN=
