# Copy to .env (never commit .env). Local-only credentials for docker-compose.
DATABASE_URL=postgres://invariant:invariant_local_only@localhost:5433/invariant

# Language model for extraction (Google Gemini via AI SDK). Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
EXTRACTION_MODEL=gemini-2.5-flash
